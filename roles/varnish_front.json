{
  "name": "varnish_frontend",
  "default_attributes": {
    "varnish": {
      "version": "2.1",
      "listen_port": "80",
      "backend_host": "127.0.0.1",
      "backend_port": "8080"
    }
  },
  "json_class": "Chef::Role",
  "env_run_lists": {
  },
  "run_list": [
    "recipe[varnish::apt_repo]",
    "recipe[varnish]"
  ],
  "description": "Install Varnish HTTP Cache infront of a specified server and port.",
  "chef_type": "role",
  "override_attributes": {
    "apache2": {
      "listen_ports": [ 
        "80",
        "443"
      ]
    }
  }
}